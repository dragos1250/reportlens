# Copy this file to .env and fill in real values. Never commit .env.
# Read by docker compose (all services) and by the services when run by hand.

# LLM provider (server-side only: in Docker it reaches the ai-service container only)
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
LLM_API_KEY=your-api-key-here

# PostgreSQL. In Docker the services reach it as "db"; POSTGRES_HOST and POSTGRES_PORT are
# for running the services by hand against:
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db
# 127.0.0.1 rather than localhost: the port is published on IPv4 only.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=reportlens
POSTGRES_USER=reportlens
POSTGRES_PASSWORD=change-me

# Web app port, on this machine only: http://127.0.0.1:8088
WEB_PORT=8088

# Limits on questions that may call the LLM (429 with Retry-After when reached).
# Costs are estimates from the model's token counts, per UTC day.
LIMIT_REQUESTS_PER_MINUTE=10
LIMIT_PER_IP_DAILY_USD=0.05
LIMIT_GLOBAL_DAILY_USD=1.00

# Uploading reports. On here, for running the app on your own machine; the code's default
# is off, so a public instance without this line accepts no uploads.
UPLOADS_ENABLED=true
UPLOAD_MAX_MB=50
UPLOAD_MAX_PAGES=600
# Below this share of pages with a text layer, a PDF is refused as scanned (there is no OCR).
UPLOAD_MIN_TEXT_SHARE=0.5
UPLOADS_PER_HOUR=3
# Uploaded reports kept at once (ready or in progress); each is deleted after 24 hours.
UPLOAD_MAX_DOCUMENTS=20

# Spoken answers. The browser voice is free and always available; ElevenLabs is optional and
# off while these two are empty. The key is used by the backend only, never by the browser.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# eleven_v4_turbo: in the author's manual check it read numbers correctly, where
# eleven_flash_v2_5 misread them with the same voice.
ELEVENLABS_MODEL=eleven_v4_turbo
# Characters a month for everyone: keep it under your plan (free plan: 10,000 credits, and
# the credits per character depend on the model: see ElevenLabs' pricing page).
ELEVENLABS_MONTHLY_CHARS=8000
# Characters read per answer, requests per minute per IP, characters per day per IP and overall.
SPEECH_MAX_CHARS=400
SPEECH_PER_MINUTE=5
SPEECH_PER_IP_DAILY_CHARS=2000
SPEECH_GLOBAL_DAILY_CHARS=20000
