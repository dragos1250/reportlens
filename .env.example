# Copy this file to .env and fill in real values. Never commit .env.

# LLM provider (server-side only, never exposed to the frontend)
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
LLM_API_KEY=your-api-key-here

# PostgreSQL (used from stage 7): docker compose up -d db
# 127.0.0.1 rather than localhost: the port is published on IPv4 only.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=reportlens
POSTGRES_USER=reportlens
POSTGRES_PASSWORD=change-me
